PORT=3000
NODE_ENV=development

# Outbound/inbound WhatsApp provider: twilio | whatsapp (Meta WhatsApp Cloud API)
MESSAGING_PROVIDER=twilio

# Meta WhatsApp Cloud API (only used when MESSAGING_PROVIDER=whatsapp)
# Webhook URL to set in the Meta app dashboard: ${PUBLIC_BASE_URL}/webhooks/whatsapp-cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

CONTENT_MAIN_MENU=
CONTENT_POST_CHECKIN_MENU=
CONTENT_CHECK_IN_LOCATION=
CONTENT_COMPANY_NAME=
CONTENT_CONTACT_NAME=
CONTENT_PHONE=
CONTENT_VISIT_LOCATION=
CONTENT_INDUSTRY_GROUP=
CONTENT_INDUSTRY=
CONTENT_DISCUSSION=
CONTENT_MEETING_OUTCOME=
CONTENT_PROSPECT_TEMPERATURE=
CONTENT_MEETING_DRAFT_ACTIONS=

# Canvas flow builder (SQLite via Prisma; path is relative to prisma/)
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me
FLOW_SESSION_IDLE_MINUTES=60
FLOW_SESSION_TIMEOUT_NOTICE=true
UPLOADS_DIR=uploads
# Tenants (src/config/tenants.js). Acme falls back to WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_ACCESS_TOKEN.
ACME_PHONE_NUMBER_ID=
ACME_ACCESS_TOKEN=
ACME_AGENT_RAVI_PHONE=
ACME_AGENT_PRIYA_PHONE=
FRESHMART_PHONE_NUMBER_ID=
FRESHMART_ACCESS_TOKEN=
FRESHMART_AGENT_ARUN_PHONE=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=jaidar-whatsapp-assets
PUBLIC_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Kolkata
LOCATION_TOKEN_TTL_SECONDS=300
REGISTERED_WHATSAPP_NUMBERS=whatsapp:+14155238886
DISABLE_TWILIO_VALIDATION=true
TWILIO_MOCK_MODE=false
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
DRAFT_EXPIRATION_HOURS=24
WHATSAPP_LOCATION_IMAGE_URL=https://jaidar-whatsapp-assets.s3.ap-south-1.amazonaws.com/whatsapp/location.png
