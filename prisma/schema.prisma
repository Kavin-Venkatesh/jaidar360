// Canvas flow builder storage. SQLite for the prototype; for Postgres change the provider
// and switch the JSON String columns to Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Flow {
  id                String        @id @default(cuid())
  tenantId          String
  name              String
  isEntry           Boolean       @default(false)
  status            String        @default("draft") // draft | active | inactive
  draftJson         String // React Flow nodes + edges + viewport
  revision          Int           @default(1)
  publishedRevision Int? // draft revision that produced activeVersion's latest publish
  activeVersion     Int?
  versions          FlowVersion[]
  submissions       Submission[]
  updatedAt         DateTime      @updatedAt
  createdAt         DateTime      @default(now())

  @@index([tenantId])
}

model FlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version     Int
  compiled    String // runtime graph JSON
  canvas      String // snapshot of the draft at publish
  publishedAt DateTime @default(now())
  publishedBy String

  @@unique([flowId, version])
}

model Session {
  id                String   @id @default(cuid())
  tenantId          String
  agentId           String
  agentPhone        String? // digits only, where replies go
  waUserId          String? // business-scoped user ID (BSUID) when Meta sends one
  status            String // active | completed | expired | cancelled
  stack             String // JSON array of frames
  vars              String // JSON: saved answers
  attempts          String   @default("{}")
  pending           String? // JSON: e.g. { type: "restart", flowId } while asking "continue or restart?"
  lastOutboundMsgId String?
  lastError         String?
  expiresAt         DateTime
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([tenantId, agentId, status])
  @@index([status, expiresAt])
}

model Submission {
  id          String   @id @default(cuid())
  tenantId    String
  agentId     String
  flowId      String
  flow        Flow     @relation(fields: [flowId], references: [id])
  flowVersion Int
  sessionId   String
  data        String // JSON answers
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

model MessageLog {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String?
  direction   String // in | out
  waMessageId String   @unique // also used for inbound dedupe
  type        String
  payload     String
  status      String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
}

// One-time browser links sent by Location Link nodes. Only the SHA-256 of the token is stored.
model LocationRequest {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  tenantId  String
  sessionId String
  flowId    String
  version   Int
  nodeId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId])
}
